---
import { base } from '../config';
import { company } from '../data/site';

interface Props {
  heading?: string;
  cta?: string;
  href?: string;
}
const {
  heading = "Not sure if your building is compliant? We'll check — free.",
  cta = 'Get your free audit',
  href = `${base}/contact`,
} = Astro.props;
---
<section class="bg-red-500 text-white">
  <div class="mx-auto max-w-6xl px-6 py-11 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <h2 class="text-2xl md:text-[34px] leading-tight max-w-2xl">{heading}</h2>
    <a
      href={href}
      class="inline-flex items-center gap-2.5 bg-ink-950 hover:bg-black text-white px-7 py-4 text-[15px] font-bold tracking-wide transition-colors whitespace-nowrap self-start md:self-auto"
    >
      {cta}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h13m0 0-5-5m5 5-5 5"/></svg>
    </a>
  </div>
</section>
