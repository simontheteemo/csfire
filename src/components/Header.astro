---
import { base } from '../config';
import { company, nav } from '../data/site';
---
<header class="sticky top-0 z-50 bg-ink-950/85 backdrop-blur border-b border-ink-700">
  <div class="mx-auto max-w-6xl px-6 h-[72px] flex items-center justify-between">
    <a href={`${base}/`} class="flex items-center gap-3 group">
      <img src={`${base}/mark-white.png`} alt="CS Fire logo" class="h-10 w-auto" />
      <span class="leading-none">
        <span class="font-display text-[26px] tracking-wide">CS <span class="text-red-500">FIRE</span></span>
        <span class="block font-body text-[9px] font-semibold tracking-[0.18em] text-muted uppercase mt-0.5">
          Control &amp; Service Fire
        </span>
      </span>
    </a>

    <nav class="hidden md:block">
      <ul class="flex gap-8 text-sm font-semibold uppercase tracking-wide">
        {nav.map(({ href, label }) => (
          <li>
            <a href={`${base}${href}`} class="text-paper/80 hover:text-paper transition-colors">{label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href={company.phoneHref}
      class="hidden sm:inline-flex items-center gap-2 bg-red-500 hover:bg-red-600 text-white px-4 py-2.5 text-sm font-bold tracking-wide transition-colors"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11 11 0 0 0 3.5.56 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.2.2 2.4.56 3.5a1 1 0 0 1-.25 1z"/>
      </svg>
      {company.phone}
    </a>
  </div>
</header>
